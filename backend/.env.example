# Copy this file to .env.

# 선택: 허용할 프런트 오리진(쉼표 구분). 기본값 * 는 개발용이라 배포 시 프런트 주소로 좁힌다
# CORS_ALLOW_ORIGINS=https://example.vercel.app
# 선택: 로그 레벨 (기본값 INFO)
# LOG_LEVEL=INFO

# 공유 SQLite DB 경로. 기본값은 editable install된 data-pipeline 소스 트리 안의
# crawling/db/reports.db (db.py가 자동으로 찾음). 다른 경로를 쓰려면 지정.
# DATABASE_PATH=../data-pipeline/crawling/db/reports.db

# 필수: 없으면 서버가 시작하지 않는다 (core/config.py REQUIRED_ENV). 토론·트렌드 리포트·리스크 분류가 사용
UPSTAGE_API_KEY=
# 필수: 데이터 함수가 읽는 Supabase Postgres 주소. data-pipeline/.env에 있으면 여기는 비워 둬도 된다
SUPABASE_DB_URL=

# agents/trend_report (Agent D) — Pinecone 키 (pgvector 전환 후 제거 예정, ADR 0005)
PINECONE_API_KEY=
PINECONE_INDEX=

# 선택 사항 (기본값 solar-mini)
# TREND_REPORT_LLM_MODEL=solar-mini
# TREND_REPORT_AS_OF_DATE=2026-06-28
# TREND_REPORT_REPORT_TOP_K=8
# TREND_REPORT_NEWS_TOP_K=5
# TREND_REPORT_MACRO_TOP_K=3

# agents/simulation (Agent G) — 리스크 분류 LLM 모델
# (기본값 solar-mini — 5개 변수 중 고르는 좁은 분류 작업이라 경량 모델로 충분)
# RISK_CLASSIFIER_MODEL=solar-mini

# agents/insight_board (Agent E) — 숫자 데이터 1~2줄 코멘트 생성 모델
# (기본값 solar-mini — 짧은 요약이라 경량 모델로 충분)
# INSIGHT_BOARD_LLM_MODEL=solar-mini

# agents/debate (Agent F) — Bull/Bear/Judge 논쟁 생성 모델
# (기본값 solar-mini. 더 강한 모델을 쓸 때는 Upstage 콘솔의 현재 model id로 override)
# DEBATE_LLM_MODEL=solar-mini

# agents/debate_renewal (Agent F 리빌드) — 기존 debate와 따로 설정한다. 모두 선택값
# (기본값 solar-pro-4·0.2·60초·2회, agents/debate_renewal/config.py)
# DEBATE_RENEWAL_LLM_MODEL=solar-pro-4
# DEBATE_RENEWAL_LLM_TEMPERATURE=0.2
# DEBATE_RENEWAL_LLM_TIMEOUT_S=60
# DEBATE_RENEWAL_LLM_MAX_RETRIES=2
